# --- Provider AI (isi minimal satu; yang kosong otomatis dilewati) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

MODEL_GROQ=llama-3.3-70b-versatile
MODEL_CEREBRAS=llama-3.3-70b
MODEL_TOGETHER=meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo
MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free

# --- 9router (opsional) ---
# Proxy lokal ke banyak provider sekaligus (openrouter/gemini/nvidia/ollama/kiro, dst).
# 1. npm install -g 9router && 9router   → dashboard kebuka otomatis di localhost:20128
# 2. Connect provider yang mau dipakai lewat dashboard
# 3. Dashboard → API Keys → copy value-nya ke ROUTER9_API_KEY di bawah
# 4. MODEL_9ROUTER diisi ID provider (mis. "gemini/gemini-3.5-flash-lite") atau nama Combo
#    yang kamu bikin di dashboard. Cek daftar model valid lewat:
#    curl http://localhost:20128/v1/models -H "Authorization: Bearer <ROUTER9_API_KEY>"
# PENTING: jangan connect akun Claude Code/subscription kerjaan ke instalasi 9router yang
# sama dipakai Hermes, kecuali kamu sengaja mau kuotanya ikut kepakai buat balas chat WA.
ROUTER9_API_KEY=
ROUTER9_BASE_URL=http://localhost:20128/v1
MODEL_9ROUTER=

# Ganti provider utama tiap N panggilan, buat nyebar beban free-tier
ROTATE_EVERY=20

# Timeout satu panggilan AI (ms). Lewat ini → lanjut ke provider berikutnya.
AI_TIMEOUT_MS=30000

# --- Admin ---
# chatId LENGKAP, termasuk @c.us atau @lid. Cek di log saat kamu chat sendiri ke bot.
ADMIN_NUMBER=628xxxxxxxxxx@c.us

# --- Perilaku ---
# Jam bot mau bales, format "mulai-selesai" (jam lokal 0-24). 0-24 = selalu aktif.
ACTIVE_HOURS=0-24

# Ekstraksi memory dijalankan tiap N pesan per kontak. Makin kecil = makin boros kuota.
MEMORY_EVERY=5

# Opsional: path SOUL.md kalau nggak mau taruh di folder repo
# SOUL_PATH=/path/ke/SOUL.md
